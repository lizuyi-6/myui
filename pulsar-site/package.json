{
  "name": "pulsar-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-library.mjs",
    "dev": "vite --host 127.0.0.1 --port 5300 --strictPort",
    "build": "npm run sync && vite build && vite build --ssr src/entry-server.jsx --outDir .server && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5300 --strictPort",
    "check:reuse": "node scripts/sync-library.mjs --check",
    "check:assets": "node scripts/check-site-assets.mjs",
    "check:browser": "node scripts/run-browser-checks.mjs",
    "evidence": "node scripts/collect-site-evidence.mjs"
  },
  "dependencies": {
    "react": "19.1.1", "react-dom": "19.1.1", "motion": "12.23.21",
    "react-router-dom": "6.30.1", "lucide-react": "0.542.0", "clsx": "2.1.1", "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "vite": "5.4.21", "@vitejs/plugin-react": "4.7.0", "@tailwindcss/vite": "4.1.13", "tailwindcss": "4.1.13", "@playwright/cli": "0.1.17"
  }
}
